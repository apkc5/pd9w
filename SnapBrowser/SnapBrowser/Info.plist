<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Partial Info.plist, merged with the generated one
	     (GENERATE_INFOPLIST_FILE stays YES). Personal-use
	     browser: LAN / Tailscale dashboards and router admin
	     pages are plain HTTP (often bare IPs), so ATS allows
	     arbitrary loads. Added in v0.4.14 so pages such as
	     http://100.76.172.45:8090/ open at all. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
